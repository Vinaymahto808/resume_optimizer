# Local dev: sqlite:///./ats_resume.db
# Production: postgresql://user:pass@host:5432/ats_resume
DATABASE_URL=sqlite:///./ats_resume.db

SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173,https://resume-optimizer-frontend.onrender.com,https://www.profileotimizer.online,https://profileotimizer.online

# Frontend URL (used to build reset-password links in emails)
FRONTEND_URL=http://localhost:5173

# Email / Resend (for password reset emails)
# Get a free API key at https://resend.com
RESEND_API_KEY=re_...
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=ProfileOptimizer

# AI Provider (Groq — get a free API key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector Search (optional — falls back to local keyword matching without these)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=job-matches
# Career knowledge base (app/career/kb). Uses Pinecone when PINECONE_API_KEY + OPENAI_API_KEY are set and
# `python -m app.career.kb.ingest` has filled the index; otherwise an in-memory store is used.
KB_PINECONE_INDEX=career-kb
# KB_STORE=local   # force the in-memory store even when Pinecone keys are set

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Analytics / GTM
GTM_ID=GTM-PHXK9HX
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ---- Career copilot (/api/career) ----
# LLM for tailoring, cover letters, the Sage coach, deep match, fraud review. Every feature
# has a rule-based fallback, so these are optional. Preference: Anthropic > Groq > OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY above also switches job/resume embeddings to text-embedding-3-small.

# Job ingestion: crawl interval, network on/off, and the initial public ATS boards to crawl.
# The board lists below seed the platform_company_boards table on first run; after that manage boards
# with the admin API (/api/career/admin/boards, X-Admin-Token). New env entries are still added.
JOB_INGEST_ENABLED=1
JOB_INGEST_INTERVAL_HOURS=6
JOB_INGEST_NETWORK=1
GREENHOUSE_BOARDS=airbnb,stripe,databricks,figma,discord,robinhood,coinbase,dropbox,instacart,reddit
LEVER_COMPANIES=palantir,spotify,zoox,ro
ASHBY_ORGS=openai,notion,ramp,linear,vercel
# Workday career sites as <host>/<tenant>/<site>, e.g. nvidia.wd5.myworkdayjobs.com/nvidia/NVIDIAExternalCareerSite
WORKDAY_BOARDS=
WORKDAY_MAX_JOBS_PER_BOARD=100
# SmartRecruiters company identifiers (the part after careers.smartrecruiters.com/)
SMARTRECRUITERS_COMPANIES=
# Licensed job-search APIs (optional; skipped when keys are empty). Both include Indian listings.
#   Adzuna: free key at https://developer.adzuna.com  ·  Jooble: free key at https://jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in
ADZUNA_MAX_DAYS_OLD=7
JOOBLE_API_KEY=
JOOBLE_LOCATIONS=India
# Search terms used for Adzuna and Jooble (comma-separated).
JOB_API_QUERIES=software engineer,data analyst,data scientist,product manager
# Himalayas remote-jobs API (no key). Set to 0 to disable.
HIMALAYAS_ENABLED=1
HIMALAYAS_MAX_JOBS=100
# LinkedIn, Naukri and Wellfound have no public jobs API and forbid scraping: users save postings from
# those sites with the Chrome extension's "Save this job" button instead (POST /api/career/jobs/import).

# Optional: full H-1B sponsor list (CSV with an employer-name column, e.g. DOL LCA disclosure data).
H1B_SPONSORS_CSV=

# Turbo prices in USD per billing period (monthly = 30 days, quarterly = 90, annual = 365).
TURBO_PRICE_MONTHLY=39.99
TURBO_PRICE_QUARTERLY=99.99
TURBO_PRICE_ANNUAL=359.99

# Plans: with no PayPal keys, Turbo upgrades are instant in development. Set to 1 to allow that in production too.
ALLOW_DEV_UPGRADE=0

# ---- Manual UPI payments (India, no gateway) ----
# Setting UPI_ID switches billing to "upi_manual": users pay a UPI QR, submit the UTR + a screenshot,
# and an admin approves in the web app at /admin (Payments tab). PayPal still takes precedence if its keys are set.
UPI_ID=
UPI_PAYEE_NAME=ProfileOptimizer
# Optional: path to the static QR you downloaded from PhonePe Business / any UPI app. Leave empty to
# generate a QR per plan that also pre-fills the amount and the payment reference.
UPI_QR_IMAGE=
# Optional: approve UPI payments automatically from the bank's credit SMS (free, no gateway).
# Install an SMS-to-webhook forwarder app on the phone that gets the bank SMS and point it at
#   POST https://<your-backend>/api/career/payments/sms-webhook   (header X-Webhook-Secret: <secret>,
#   or ?secret=<secret> if the app can't set headers), body {"from": "<sender>", "message": "<sms text>"}.
# A pending payment whose UTR matches the SMS, for at least the plan amount, is approved instantly.
# Both are required. SMS_ALLOWED_SENDERS is a comma-separated list of bank sender IDs, e.g. HDFCBK,SBIUPI,ICICIT.
SMS_WEBHOOK_SECRET=
SMS_ALLOWED_SENDERS=
# Turbo prices in whole rupees (30 / 90 / 365 days).
TURBO_PRICE_INR_MONTHLY=499
TURBO_PRICE_INR_QUARTERLY=1299
TURBO_PRICE_INR_ANNUAL=3999
# Long random secret for the admin panel, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_TOKEN=
# Where "new payment to review" emails go (sent through the RESEND / Postmark / SMTP settings above).
ADMIN_EMAIL=

# ---- Accounts & admin ----
# Users with these emails become admins when they log in (comma separated). Or run:
#   uv run python -m app.career.make_admin you@example.com
ADMIN_EMAILS=
