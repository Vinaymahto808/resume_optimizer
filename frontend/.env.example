# Copy to .env (dev) or .env.production (build) and fill in. Only VITE_* values reach the browser.

# Backend URL for production builds (leave empty when the API is served from the same origin).
VITE_API_URL=

# Google AdSense — shown to free-plan users only (Turbo/Pro never load it).
# Publisher id from AdSense → Account → Account information. Also generates /ads.txt at build time.
# Example: ca-pub-1234567890123456
VITE_ADSENSE_ID=
# Ad unit ids from AdSense → Ads → By ad unit (create "Display ads"; in-feed may reuse the banner unit).
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_RECTANGLE=
VITE_ADSENSE_SLOT_INFEED=
